# Reference list of every environment variable used by Roll.
# Copy the relevant parts into apps/web/.env.local and apps/extension/.env
# (see README → "Configure environment").

# ── apps/web/.env.local ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
EXTENSION_ID=
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/
# Optional distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── apps/extension/.env ──────────────────────────────────────────────────────
# extension
WXT_APP_URL=http://localhost:3000
